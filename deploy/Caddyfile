# Managed by a-view deployment scripts.
@DOMAIN@ {
	encode zstd gzip

	header {
		# Browsers that have visited once keep to HTTPS. Subdomains are not included.
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	@development path /dev /dev/*
	respond @development 404

	# Caddy flushes text/event-stream responses immediately, preserving SSE.
	reverse_proxy 127.0.0.1:4173
}
